{
  "findAll": {
    "method": "GET",
    "path": "/api/products",
    "curl": "curl -X GET http://localhost:8080/api/products -H \"Content-Type: application/json\" -H \"Accept: application/json\""
  },
  "findById": {
    "method": "GET",
    "path": "/api/products/{id}",
    "curl": "curl -X GET http://localhost:8080/api/products/1 -H \"Content-Type: application/json\" -H \"Accept: application/json\""
  },
  "findByCode": {
    "method": "GET",
    "path": "/api/products/code/{code}",
    "curl": "curl -X GET http://localhost:8080/api/products/code/ABC12345 -H \"Content-Type: application/json\" -H \"Accept: application/json\""
  },
  "save": {
    "method": "POST",
    "path": "/api/products",
    "curl": "curl -X POST http://localhost:8080/api/products -H \"Content-Type: application/json\" -H \"Accept: application/json\" -d '{\"name\": \"Notebook\", \"model\": \"Inspiron 15\", \"code\": \"ABC12345\", \"price\": 3499.90}'"
  },
  "update": {
    "method": "PUT",
    "path": "/api/products/{id}",
    "curl": "curl -X PUT http://localhost:8080/api/products/1 -H \"Content-Type: application/json\" -H \"Accept: application/json\" -d '{\"name\": \"Notebook\", \"model\": \"Inspiron 15\", \"code\": \"ABC12345\", \"price\": 2999.90}'"
  },
  "delete": {
    "method": "DELETE",
    "path": "/api/products/{id}",
    "curl": "curl -X DELETE http://localhost:8080/api/products/1 -H \"Content-Type: application/json\" -H \"Accept: application/json\""
  }
}
